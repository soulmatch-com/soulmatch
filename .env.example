# Supabase Configuration
# Local development: populate these in untracked .env.local with values from
# `supabase status -o env`. Production values belong only in the approved
# deployment environment; never copy them into local tracked files.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only durable rate limiting for POST /api/celebrations/enquiries.
# Required in production. Local development bypasses limiting when omitted.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
CELEBRATION_RATE_LIMIT_SALT=generate_a_long_random_server_only_value

# Server-only durable rate limiting for POST /api/notifications/subscribers.
# Required in production. It reuses the configured Upstash REST store above;
# local development bypasses limiting when omitted.
NOTIFICATION_SUBSCRIBER_RATE_LIMIT_SALT=generate_a_different_long_random_server_only_value

# Server-only notification provider configuration. A worker refuses delivery
# when either value is unavailable; no email is sent during build or tests.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_UNSUBSCRIBE_SECRET=generate_a_dedicated_long_random_server_only_value
NOTIFICATION_PUBLIC_BASE_URL=https://mythirumanam.in
NOTIFICATION_WORKER_SECRET=generate_a_dedicated_long_random_server_only_value
# Scheduled delivery remains disabled unless this value is exactly true.
NOTIFICATION_SCHEDULER_ENABLED=false
# Vercel Cron sends this server-only secret as a Bearer Authorization header.
CRON_SECRET=

# Cloudflare Turnstile bot protection for celebration enquiry submission.
# Site key is browser-visible; secret and hostname allowlist are server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ALLOWED_HOSTNAMES=your-production-domain.example

# Server-only Gmail OAuth notification configuration for persisted celebration enquiries.
GMAIL_OAUTH_CLIENT_ID=your_google_oauth_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token
CELEBRATION_BOOKINGS_EMAIL=bookings.mythirumanam@gmail.com
CELEBRATION_EMAIL_FROM="MyThirumanam <bookings.mythirumanam@gmail.com>"

# Public MyThirumanam contact details. Leave phone/WhatsApp blank until approved
# E.164 business numbers are available.
NEXT_PUBLIC_MYTHIRUMANAM_CONTACT_EMAIL=
NEXT_PUBLIC_MYTHIRUMANAM_PHONE_E164=
NEXT_PUBLIC_MYTHIRUMANAM_WHATSAPP_E164=

# Public social profile URLs. Leave a value blank to hide that icon in the footer.
NEXT_PUBLIC_MYTHIRUMANAM_INSTAGRAM_URL=https://www.instagram.com/mythirumanam/
NEXT_PUBLIC_MYTHIRUMANAM_FACEBOOK_URL=https://www.facebook.com/Mythirumanamm/
NEXT_PUBLIC_MYTHIRUMANAM_YOUTUBE_URL=
NEXT_PUBLIC_MYTHIRUMANAM_LINKEDIN_URL=
NEXT_PUBLIC_MYTHIRUMANAM_X_URL=https://x.com/mythirumanam

# Server-only content approval gate. Enable only after the target environment's
# published success stories have been reviewed and approved by a content owner.
SUCCESS_STORIES_PUBLICATION_APPROVED=false

# Local-only admin bootstrap. Keep disabled in production.
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_EMAIL=
ADMIN_SETUP_PASSWORD=

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application URL
# For local: http://localhost:3000
# For Vercel: https://your-project-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to version control
#
# VERCEL DEPLOYMENT:
# Add these variables in Vercel Dashboard:
# Project Settings > Environment Variables > Add all variables above
#
# Make sure to update NEXT_PUBLIC_APP_URL to your Vercel URL after deployment
