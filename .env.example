# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Application URL
# For local: http://localhost:3000
# For Vercel: https://your-project-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to version control
#
# VERCEL DEPLOYMENT:
# Add these variables in Vercel Dashboard:
# Project Settings > Environment Variables > Add all variables above
#
# Make sure to update NEXT_PUBLIC_APP_URL to your Vercel URL after deployment
